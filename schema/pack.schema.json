{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aadvark/Qonverse/schema/pack.schema.json",
  "title": "Qonverse scenario pack",
  "type": "object",
  "required": [
    "qonverse_pack_version",
    "pack",
    "scenarios"
  ],
  "properties": {
    "qonverse_pack_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "pack": {
      "type": "object",
      "required": [
        "id",
        "title",
        "target_language",
        "learner_language"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "industry": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "learner_language": {
          "type": "string"
        },
        "target_language": {
          "type": "string",
          "description": "BCP-47 tag, e.g. ja-JP"
        },
        "romanization_system": {
          "type": "string"
        },
        "politeness": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "generated_by": {
          "type": "string"
        },
        "created": {
          "type": "string"
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "phrases"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "title_target": {
            "type": "string"
          },
          "title_romanization": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "phrases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/phrase"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "line": {
      "type": "object",
      "required": [
        "text",
        "meaning"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "romanization": {
          "type": "string"
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dialogueLine": {
      "allOf": [
        {
          "$ref": "#/$defs/line"
        }
      ],
      "type": "object",
      "required": [
        "speaker"
      ],
      "properties": {
        "speaker": {
          "type": "string"
        },
        "uses_phrase": {
          "type": "boolean"
        }
      }
    },
    "phrase": {
      "type": "object",
      "required": [
        "id",
        "text",
        "meaning",
        "politeness",
        "in_a_sentence",
        "when_to_use",
        "example",
        "likely_responses"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "romanization": {
          "type": "string"
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "literal": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/line"
          }
        },
        "politeness": {
          "enum": [
            "very formal",
            "polite",
            "casual"
          ]
        },
        "in_a_sentence": {
          "$ref": "#/$defs/line"
        },
        "when_to_use": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        },
        "example": {
          "type": "object",
          "required": [
            "dialogue"
          ],
          "properties": {
            "setting": {
              "type": "string"
            },
            "dialogue": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "$ref": "#/$defs/dialogueLine"
              }
            }
          }
        },
        "likely_responses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/line"
          }
        }
      }
    }
  }
}